# OpenAI is used for query embeddings and grounded answer generation.
OPENAI_API_KEY=

# Qdrant local: http://localhost:6333
# Qdrant Cloud: use the HTTPS cluster endpoint from the Qdrant Cloud dashboard.
QDRANT_URL=
QDRANT_API_KEY=

# Streamlit UI -> FastAPI backend.
RSE_API_URL=http://localhost:8000

# Comma-separated origins allowed to call FastAPI. Add your Streamlit Community Cloud URL after deployment.
RSE_CORS_ORIGINS=http://localhost:8501,http://127.0.0.1:8501

# Free-tier deploy default: keep cross-encoder reranking off to avoid 512MB memory pressure.
RSE_APPLY_RERANKING=false

# Lightweight in-process retrieval cache.
RSE_QUERY_CACHE_TTL_SECONDS=300
RSE_QUERY_CACHE_MAX_ENTRIES=128

# Optional ingestion-only settings.
OPENALEX_API_KEY=
OPENALEX_EMAIL=
